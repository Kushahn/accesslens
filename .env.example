# AccessLens configuration — all optional, sensible defaults are built in.

# Replay a bundled scan instead of scanning live (offline demo / CI).
# Default: 0 (scan the URL you enter).
ACCESSLENS_MOCK=0

# Allow scanning localhost / private hosts. Off by default as an SSRF guard;
# turn on only to scan a site running on your own machine.
ACCESSLENS_ALLOW_LOCAL=0
